<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>udp_camera_ros</name>
  <version>0.1.0</version>
  <description>
    Ground-station UDP H.264/RTP lifecycle receiver (C++). Native GStreamer
    appsink decode; default path publishes CompressedImage via GStreamer
    jpegenc (I420→JPEG). Optional publish_raw uses image_transport
    CameraPublisher (raw + compressed_image_transport).
  </description>
  <maintainer email="mateuszwojcikv@gmail.com">drone</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>compressed_image_transport</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml_cpp_vendor</depend>

  <build_depend>pkg-config</build_depend>
  <build_depend>libgstreamer1.0-dev</build_depend>
  <build_depend>libgstreamer-plugins-base1.0-dev</build_depend>

  <exec_depend>gstreamer1.0-tools</exec_depend>
  <exec_depend>gstreamer1.0-plugins-base</exec_depend>
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>
  <exec_depend>gstreamer1.0-plugins-bad</exec_depend>
  <exec_depend>gstreamer1.0-libav</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
